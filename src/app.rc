#include <windows.h>
101 ICON "assets/paperdesk.ico"
102 RCDATA "assets/parchment.png"
103 DIALOGEX 0, 0, 250, 158
STYLE DS_SETFONT | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Paperdesk / Quick reference"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Quick reference", 1001, 14, 12, 165, 15
    LTEXT "F1", 1002, 207, 14, 14, 11
    CONTROL "Close", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 226, 9, 17, 19
    LTEXT "Write / edit", -1, 14, 38, 94, 11
    LTEXT "Double-click", 2001, 116, 38, 123, 11
    LTEXT "Move note", -1, 14, 52, 94, 11
    LTEXT "Alt + drag", 2002, 116, 52, 123, 11
    LTEXT "Move text", -1, 14, 66, 94, 11
    LTEXT "Alt + Shift + drag", 2003, 116, 66, 123, 11
    LTEXT "Scale note", -1, 14, 80, 94, 11
    LTEXT "Drag bottom-right corner", 2004, 116, 80, 123, 11
    LTEXT "Text size", -1, 14, 94, 94, 11
    LTEXT "Right-click text", 2005, 116, 94, 123, 11
    LTEXT "More actions", -1, 14, 108, 94, 11
    LTEXT "Right-click note", 2006, 116, 108, 123, 11
    LTEXT "Save / cancel", -1, 14, 122, 94, 11
    LTEXT "Ctrl + Enter / Esc", 2007, 116, 122, 123, 11
    LTEXT "New note", -1, 14, 136, 94, 11
    LTEXT "Launcher: New paper note", 2008, 116, 136, 123, 11
END
1 VERSIONINFO
FILEVERSION 0,1,4,0
PRODUCTVERSION 0,1,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Paperdesk - paper notes for your desktop\0"
            VALUE "FileVersion", "0.1.4\0"
            VALUE "ProductName", "Paperdesk\0"
            VALUE "ProductVersion", "0.1.4\0"
            VALUE "OriginalFilename", "Paperdesk.exe\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Paperdesk contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
